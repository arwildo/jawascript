// Hello World ne
tampilno("piye kabare jagad!");

// Variable ne
ono x = 10;
ono y = 20;

// Print ne
tampilno(x + y);

// If statement ne, ojo lali yo mas e!
yen (x < y) {
    tampilno("x luwih cilik");
} ora {
    tampilno("x luwih gedhe");
}

// teksDadiInteger
y = teksDadiInteger("123");

// teksDadiDesimal
x = teksDadiDesimal("1.23");

// const
tetep jeneng = "Iron Man";

// function
fungsi tambah(a, b) {
    balekno a + b;
}

// while
ono angka = 0;
nganti (angka < 5) {
    tampilno(angka);
    angka++;
}

// for
kanggo (ono i = 0; i < 5; i++) {
    tampilno("Ojo lali, i = " + i);
}

// break
kanggo (ono i = 0; i < 10; i++) {
    yen (i padhaKaro 5) {
        mandheg;
    }
}

// continue
kanggo (ono i = 0; i < 10; i++) {
    yen (i padhaKaro 5) {
        lanjutna;
    }

    tampilno("Aku ora ketok angka 5");
}

// lan
yen (x gedhe 1 lan y gedhe 1) {
    tampilno("Loro-lorone bener, ojo lali!");
}

// utawa
yen (x gedhe 100 utawa y gedhe 100) {
    tampilno("Salah siji dadi Iron Man");
}

// padhaKaro
yen (x padhaKaro 10) {
    tampilno("10 iku 10, matematika ora iso ngapusi");
}

// oraPadha
yen (x oraPadha 999) {
    tampilno("x dudu 999");
}

// gedhePadha
yen (x gedhePadha 10) {
    tampilno("x gedhe utawa padha 10");
}

// cilikPadha
yen (y cilikPadha 20) {
    tampilno("y cilik utawa padha 20");
}

// gedhe
yen (y gedhe 10) {
    tampilno("y luwih gedhe saka 10");
}

// cilik
yen (x cilik 20) {
    tampilno("x luwih cilik saka 20");
}

// bener
ono ironMan = bener;

// salah
ono thanos = salah;

// suwung
ono baterei = suwung;

// rajelas
ono avengers = rajelas;

// nyoba
nyoba {
    tampilno("Tony Stark lagi ngoding");
} nompo (err) {
    tampilno("Waduh, error mas e!");
} akhire {
    tampilno("Ojo lali commit");
}

// buang
fungsi cekArmor(armor) {
    yen (armor cilik 0) {
        buang "Armor Iron Man ilang";
    }

    balekno armor;
}

// milih, kasus, asale
ono pilihan = 2;

milih (pilihan) {
    kasus 1:
        tampilno("Thor");
        mandheg;

    kasus 2:
        tampilno("Iron Man");
        mandheg;

    asale:
        tampilno("Ojo lali, Avengers durung lengkap");
}

// kelas
kelas Pahlawan {
    konstruktor(nama) {
        this.nama = nama;
    }

    salam() {
        tampilno("Halo, aku " + this.nama);
    }
}

// warisan
kelas IronMan warisan Pahlawan {
    konstruktor(nama, armor) {
        super(nama);
        this.armor = armor;
    }

    terbang() {
        tampilno(this.nama + " lagi mabur nganggo armor");
    }
}

// anyar
ono pahlawan = anyar Pahlawan("Batman");
pahlawan.salam();

ono ironman = anyar IronMan("Iron Man", "Mark 85");
ironman.salam();
ironman.terbang();
